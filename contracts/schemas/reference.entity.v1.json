{
  "$id": "https://corei.local/schemas/reference.entity.v1.json",
  "additionalProperties": false,
  "properties": {
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "base_currency": {
      "pattern": "^[A-Z][A-Z0-9]{2,5}$",
      "title": "Base Currency",
      "type": "string"
    },
    "entity_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Entity Id",
      "type": "string"
    },
    "jurisdiction": {
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,8})?$",
      "title": "Jurisdiction",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "regulator": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Regulator"
    },
    "reporting_timezone": {
      "pattern": "^[A-Za-z]+(/[A-Za-z_\\-]+)+$|^UTC$",
      "title": "Reporting Timezone",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "entity_id",
    "name",
    "jurisdiction",
    "base_currency",
    "reporting_timezone"
  ],
  "title": "LegalEntity",
  "type": "object",
  "x-corei-event-type": "reference.entity",
  "x-corei-schema-version": 1
}
