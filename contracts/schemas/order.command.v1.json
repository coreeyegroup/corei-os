{
  "$defs": {
    "ExecutionMode": {
      "enum": [
        "OFF",
        "SIMULATION",
        "PAPER",
        "LIVE_SEMI",
        "LIVE_AUTO"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "MARKET",
        "LIMIT"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "Origin": {
      "enum": [
        "CORE",
        "EXTERNAL"
      ],
      "title": "Origin",
      "type": "string"
    },
    "Purpose": {
      "enum": [
        "OPEN",
        "REDUCE",
        "CLOSE"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "Side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "TimeInForce": {
      "enum": [
        "DAY",
        "IOC"
      ],
      "title": "TimeInForce",
      "type": "string"
    }
  },
  "$id": "https://corei.local/schemas/order.command.v1.json",
  "additionalProperties": false,
  "description": "The only thing that may reach a broker adapter (F06).",
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Account Id",
      "type": "string"
    },
    "as_of_ns": {
      "exclusiveMaximum": 100000000000000000000,
      "exclusiveMinimum": 0,
      "title": "As Of Ns",
      "type": "integer"
    },
    "capital_partition": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Capital Partition",
      "type": "string"
    },
    "client_order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Client Order Id",
      "type": "string"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Command Id",
      "type": "string"
    },
    "config_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Config Version",
      "type": "string"
    },
    "control_fence": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "title": "Control Fence",
      "type": "array"
    },
    "expires_at_ns": {
      "exclusiveMaximum": 100000000000000000000,
      "exclusiveMinimum": 0,
      "title": "Expires At Ns",
      "type": "integer"
    },
    "instrument_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_version": {
      "minimum": 0,
      "title": "Instrument Version",
      "type": "integer"
    },
    "intent_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Intent Id",
      "type": "string"
    },
    "limit_price_units": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 1000000000000000000000000000000,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Price Units"
    },
    "mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "order_type": {
      "$ref": "#/$defs/OrderType"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "policy_decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Policy Decision Id",
      "type": "string"
    },
    "portfolio_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Portfolio Id",
      "type": "string"
    },
    "portfolio_state_version": {
      "minimum": 0,
      "title": "Portfolio State Version",
      "type": "integer"
    },
    "price_scale": {
      "maximum": 18,
      "minimum": 0,
      "title": "Price Scale",
      "type": "integer"
    },
    "purpose": {
      "$ref": "#/$defs/Purpose"
    },
    "quantity_scale": {
      "maximum": 18,
      "minimum": 0,
      "title": "Quantity Scale",
      "type": "integer"
    },
    "quantity_units": {
      "exclusiveMinimum": 0,
      "maximum": 1000000000000000000000000000000,
      "title": "Quantity Units",
      "type": "integer"
    },
    "reservation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Reservation Id",
      "type": "string"
    },
    "risk_decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Risk Decision Id",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "strategy_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
      "title": "Strategy Version",
      "type": "string"
    },
    "time_in_force": {
      "$ref": "#/$defs/TimeInForce"
    }
  },
  "required": [
    "command_id",
    "client_order_id",
    "account_id",
    "portfolio_id",
    "mode",
    "origin",
    "capital_partition",
    "intent_id",
    "strategy_id",
    "strategy_version",
    "instrument_id",
    "instrument_version",
    "side",
    "purpose",
    "order_type",
    "time_in_force",
    "quantity_units",
    "quantity_scale",
    "price_scale",
    "reservation_id",
    "risk_decision_id",
    "policy_decision_id",
    "portfolio_state_version",
    "control_fence",
    "config_version",
    "as_of_ns",
    "expires_at_ns"
  ],
  "title": "ApprovedOrderCommand",
  "type": "object",
  "x-corei-event-type": "order.command",
  "x-corei-schema-version": 1
}
