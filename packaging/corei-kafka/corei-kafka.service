[Unit]
Description=Apache Kafka (KRaft, single node) for COREI OS
Documentation=https://kafka.apache.org/38/documentation.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=corei-kafka
Group=corei-kafka
Environment=KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
Environment=LOG_DIR=/var/log/corei-kafka
ExecStart=/opt/corei-kafka/bin/kafka-server-start.sh /etc/corei-kafka/server.properties
ExecStop=/opt/corei-kafka/bin/kafka-server-stop.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=100000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/corei-kafka /var/log/corei-kafka

[Install]
WantedBy=multi-user.target
