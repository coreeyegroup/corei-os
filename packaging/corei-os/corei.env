# COREI OS settings, read by every corei-* service and by the `corei-os` command.
# This file is a dpkg conffile: upgrades never overwrite your changes.
# Mode 0640 root:corei. Never commit it anywhere.

# Environment name: lowercase, used in Kafka topic names (corei.<env>.*).
COREI_ENV=prod
COREI_TENANT=corei

# PostgreSQL connection. `corei-os-server` fills this in with a generated password.
# For a remote database set it yourself, e.g. postgresql://corei:<password>@db-host:5432/corei
DATABASE_URL=

# Kafka bootstrap servers. `corei-os-server` sets 127.0.0.1:9092.
KAFKA_BOOTSTRAP=

# Modes this host may run. LIVE modes are refused by this build (stage H).
COREI_ALLOWED_MODES=PAPER,BACKTEST
COREI_ENVELOPE_MODE=PAPER

# Operator API (listens on localhost by default; put a TLS proxy in front to expose it).
COREI_API_HOST=127.0.0.1
COREI_API_PORT=8780
# Principals: name:role[,role]:sha256(token);...  Roles: viewer, trading_ops, risk_admin.
# Generate a hash with:  printf '%s' "$TOKEN" | sha256sum
COREI_API_PRINCIPALS=
